# Mark UI website — production environment.
#
# On the server this lives at /srv/markui/app/.env.local, owned by the `markui`
# user with mode 0600. Next loads `.env.local` in production as well as in
# development, and it is git-ignored, so nothing here ever reaches the repo.
#
# server-setup.sh writes the first two sections for you. This file is the
# reference for what has to be there — and what to restore from if the server
# is ever rebuilt.

# ─── Required ────────────────────────────────────────────────────────────────

# The content store. Everything the admin dashboard publishes lives here.
# Without it the site will not even build: /services/[slug] enumerates the
# services at build time.
#
# Port 3307, not 3306: on this VPS :3306 is MariaDB, which belongs to another
# site and cannot load database/schema.sql. Ours is MySQL 8 in the
# `markui-mysql` container.
DATABASE_URL=mysql://markui:CHANGE_ME@127.0.0.1:3307/markui

# Admin sign-in. Generate all three with `npm run admin:setup` — it writes them
# into .env.local and prints the password once. The plaintext password is never
# stored anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:CHANGE_ME
# Signs the session cookie. Changing it signs everyone out. At least 16 chars;
# the setup script generates 32 random bytes.
ADMIN_SESSION_SECRET=CHANGE_ME

# ─── Optional ────────────────────────────────────────────────────────────────

# Google reviews (app/api/reviews). Nothing on the site calls this endpoint
# today, so leaving both unset costs nothing; unset, a direct request to
# /api/reviews answers 500.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
