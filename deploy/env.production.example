# Mark UI website — production environment.
#
# On the server this lives at /srv/markui/app/.env.local, owned by the `markui`
# user with mode 0600. Next loads `.env.local` in production as well as in
# development, and it is git-ignored, so nothing here ever reaches the repo.
#
# server-setup.sh writes the first two sections for you. This file is the
# reference for what has to be there — and what to restore from if the server
# is ever rebuilt.

# ─── Required ────────────────────────────────────────────────────────────────

# The content store. Everything the admin dashboard publishes lives here.
# Without it the site will not even build: /services/[slug] enumerates the
# services at build time.
#
# Port 3307, not 3306: on this VPS :3306 is MariaDB, which belongs to another
# site and cannot load database/schema.sql. Ours is MySQL 8 in the
# `markui-mysql` container.
DATABASE_URL=mysql://markui:CHANGE_ME@127.0.0.1:3307/markui

# Admin sign-in. Generate all three with `npm run admin:setup` — it writes them
# into .env.local and prints the password once. The plaintext password is never
# stored anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:CHANGE_ME
# Signs the session cookie. Changing it signs everyone out. At least 16 chars;
# the setup script generates 32 random bytes.
ADMIN_SESSION_SECRET=CHANGE_ME

# ─── Optional ────────────────────────────────────────────────────────────────

# Google reviews (app/api/reviews). Nothing on the site calls this endpoint
# today, so leaving both unset costs nothing; unset, a direct request to
# /api/reviews answers 500.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# ─── Creative Vault (creative.markui.lk) ─────────────────────────────────────
# The Vault is served by this same app on its own host (next.config.ts). These
# default to the production addresses; set them only to test locally, e.g.
# VAULT_HOST=creative.localhost and VAULT_ORIGIN=http://creative.localhost:3000.
# VAULT_HOST=creative.markui.lk
# VAULT_ORIGIN=https://creative.markui.lk
# SITE_ORIGIN=https://markui.lk

# Google Drive photo folders. Without a key, public folders are still read
# (Drive's embeddable folder view), but without photo sizes or videos and in
# smaller numbers. Create an API key in Google Cloud with only the "Google
# Drive API" enabled and restricted to it. Folders must be shared as
# "Anyone with the link".
# GOOGLE_DRIVE_API_KEY=

# Website screenshots ("Capture" in a Website section) use Microlink's free
# tier; a key lifts its daily limit.
# MICROLINK_API_KEY=

# Largest single Vault upload, in MB. Keep deploy/nginx/markui-body.conf's
# client_max_body_size for /api/vault/upload above it.
# VAULT_MAX_UPLOAD_MB=500

# ─── Media storage (ServerByt, media.markui.lk) ─────────────────────────────
# Uploads are copied to ServerByt over SSH and checked by SHA-256 there before
# they're accepted (lib/media-remote.ts); deploy/media-sync.sh is the safety
# net. Leave MEDIA_REMOTE_HOST unset to keep everything on local disk.
# MEDIA_REMOTE_HOST=markui.lk@ssh.us.stackcp.com
# MEDIA_REMOTE_DIR=public_html/markui-media/srv/markui/data/uploads
# MEDIA_REMOTE_SSH_KEY=/srv/markui/.ssh/serverbyt_media
# MEDIA_REMOTE_KNOWN_HOSTS=/srv/markui/.ssh/known_hosts
# MEDIA_PUBLIC_ORIGIN=https://media.markui.lk
# MEDIA_LOCAL_COPIES=remove      # production: drop the local copy once ServerByt has it
#                                # (verified); "keep" (the default) keeps one here too
# MEDIA_REMOTE_REQUIRED=1        # "0": accept uploads even if ServerByt is unreachable
