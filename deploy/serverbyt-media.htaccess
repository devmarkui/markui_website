# Installed on ServerByt as ~/public_html/markui-media/srv/markui/data/uploads/.htaccess
# (the document root of media.markui.lk).
# Mark UI media (media.markui.lk). File names are random UUIDs and never
# reused, so a stored file never changes: let browsers and StackCDN keep it.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|gif|avif|tiff?|heic|heif|svg|pdf|mp4|webm|mov|m4v)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  # An uploaded SVG opened on its own must not run script.
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
  </FilesMatch>
</IfModule>
