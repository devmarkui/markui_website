# Copy to .env.local and fill in. .env.local is never committed.

# ─── Admin login ─────────────────────────────────────────────────────────────
# Used until an account is saved in Admin → Account.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/markui

# ─── Enquiry email ───────────────────────────────────────────────────────────
# Where the Contact page form and the Home page form are delivered.
# Get these from whoever hosts the markui.lk mailbox (cPanel, Zoho, Google
# Workspace, Microsoft 365 …). Until SMTP_HOST and SMTP_USER are set,
# submissions are still saved and visible in Admin → Form Submissions, but no
# email goes out.
SMTP_HOST=
# 465 for SSL, 587 for STARTTLS.
SMTP_PORT=465
SMTP_USER=info@markui.lk
SMTP_PASS=
# Optional. Both default to SMTP_USER.
MAIL_TO=info@markui.lk
MAIL_FROM=info@markui.lk

# ─── Google reviews (optional) ───────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ─── Creative Vault (creative.markui.lk) ─────────────────────────────────────
# The Vault is served by this same app on its own host (next.config.ts). These
# default to the production addresses; set them only to test locally, e.g.
# VAULT_HOST=creative.localhost and VAULT_ORIGIN=http://creative.localhost:3000.
# VAULT_HOST=creative.markui.lk
# VAULT_ORIGIN=https://creative.markui.lk
# SITE_ORIGIN=https://markui.lk

# Google Drive photo folders. Without a key, public folders are still read
# (Drive's embeddable folder view), but without photo sizes or videos and in
# smaller numbers. Create an API key in Google Cloud with only the "Google
# Drive API" enabled and restricted to it. Folders must be shared as
# "Anyone with the link".
# GOOGLE_DRIVE_API_KEY=

# Website screenshots ("Capture" in a Website section) use Microlink's free
# tier; a key lifts its daily limit.
# MICROLINK_API_KEY=

# Largest single Vault upload, in MB. Keep deploy/nginx/markui-body.conf's
# client_max_body_size for /api/vault/upload above it.
# VAULT_MAX_UPLOAD_MB=500
